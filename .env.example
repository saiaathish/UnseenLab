# UnseenLab optional configuration (all values are placeholders)
# Copy to .env for local use. NEXT_PUBLIC_* values are baked at build time.

# --- Hosted-model adaptation (existing) ---
NEXT_PUBLIC_LLM_ENABLED=1
# Server-side only — never commit a real key.
LLM_API_KEY=sk-your-key-here
# Optional: OpenAI-compatible base URL and model name
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Firebase Auth + MongoDB (optional platform layer) ---
# Without these, the app runs in guest-only mode: the lab is fully usable,
# nothing signs in, and all data stays on the device.
# Browser-safe publishable values from the Firebase web app
# (Firebase console → Project settings → Your apps → SDK setup and
# configuration). See docs/firebase-mongodb-setup.md for the full checklist.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Server-only secrets — never commit real values, and never put them in any
# environment file consumed by the browser. Get them from the console and
# fill them into your local .env (see docs/firebase-mongodb-setup.md):
#   FIREBASE_SERVICE_ACCOUNT — the Firebase service-account JSON as a single
#     line (console → Project settings → Service accounts → Generate new
#     private key). Never commit a real one.
#   MONGODB_URI — MongoDB connection string (Atlas or local); it contains
#     credentials, so it is server-only.
# Optional:
# MONGODB_DB=unseenlab

# Never commit service accounts, MongoDB connection strings, or Google OAuth
# client secrets to any environment file or repository.
