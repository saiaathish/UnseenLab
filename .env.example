# UnseenLab optional hosted-model configuration (all values are placeholders)
# Copy to .env for local use. NEXT_PUBLIC_* values are baked at build time.
NEXT_PUBLIC_LLM_ENABLED=1
# Server-side only — never commit a real key.
LLM_API_KEY=sk-your-key-here
# Optional: OpenAI-compatible base URL and model name
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
