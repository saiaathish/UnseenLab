# UnseenLab optional configuration (all values are placeholders)
# Copy to .env for local use. NEXT_PUBLIC_* values are baked at build time.

# --- Hosted-model adaptation (existing) ---
NEXT_PUBLIC_LLM_ENABLED=1
# Server-side only — never commit a real key.
LLM_API_KEY=sk-your-key-here
# Optional: OpenAI-compatible base URL and model name
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Supabase (optional platform layer) ---
# Without these, the app runs in guest-only mode: the lab is fully usable,
# nothing signs in, and all data stays on the device.
# Create a project, then copy its URL and publishable key (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon key name is also accepted if the project predates publishable keys:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never add SUPABASE_SERVICE_ROLE_KEY, database passwords, or Google OAuth
# client secrets to any environment file consumed by the browser or committed.
